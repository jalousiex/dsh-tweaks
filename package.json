{
  "name": "dsh-tweaks",
  "version": "0.3.0",
  "description": "Switchable small tweaks for DeepSeek Harness (dsh): one YAML block decides which behaviours are on, so the set travels across machines with the profile instead of hiding in scattered files.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tweaks",
    "settings",
    "patch"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "yaml": "2.8.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}